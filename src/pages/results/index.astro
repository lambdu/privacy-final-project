---
import Base from '../../layouts/Base.astro';
import Results from '../../components/Results';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Your results · Privacy Tool Picker">
  <!-- Answers live in localStorage, so this renders client-side only. -->
  <Results client:only="preact" base={base} />
</Base>
